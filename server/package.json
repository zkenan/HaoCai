{
  "name": "xapiaihaocai-server",
  "version": "1.0.0",
  "description": "人工智能学院耗材出入库管理系统 - 后端服务",
  "main": "app.js",
  "bin": "app.js",
  "pkg": {
    "scripts": [
      "app.js",
      "config/*.js",
      "config/*.json",
      "routes/*.js",
      "middleware/*.js",
      "utils/*.js"
    ],
    "assets": [
      "public/**/*",
      "uploads/**/*",
      "database.sql"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build": "npx pkg . --targets node18-win-x64 --output ../耗材管理系统.exe --options experimental-modules",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "migrate:status": "knex migrate:status",
    "test": "jest __tests__/ --forceExit",
    "test:verbose": "jest __tests__/ --forceExit --verbose"
  },
  "keywords": [
    "耗材管理",
    "出入库"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.10",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1",
    "supertest": "^7.2.2"
  }
}
