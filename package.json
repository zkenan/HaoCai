{
  "name": "xapiaihaocai",
  "version": "2.1.0",
  "description": "耗材出入库管理系统",
  "main": "server/app.js",
  "scripts": {
    "dev": "concurrently \"cd server && npm run dev\" \"cd client && npm run dev\"",
    "install-all": "cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "deploy:linux": "sudo ./deploy-linux.sh",
    "deploy:docker": "./deploy-docker.sh"
  },
  "keywords": [
    "耗材管理",
    "出入库",
    "inventory",
    "management"
  ],
  "author": "zkenan",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
