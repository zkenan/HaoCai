# ===========================================
# 耗材出入库管理系统 - 部署配置
# ===========================================
# 使用方法：
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 修改下方配置项
#   3. 启动服务
#      docker-compose up -d

# ===========================================
# 数据库配置（必须修改）
# ===========================================
# 填写你的MySQL服务器连接信息
DB_HOST=你的MySQL服务器IP
DB_PORT=3306
DB_DATABASE=xapiaihaocai
DB_USER=你的数据库用户名
DB_PASSWORD=你的数据库密码

# ===========================================
# JWT密钥（必须修改）
# ===========================================
# 生成随机密钥命令：
#   openssl rand -hex 32
JWT_SECRET=请替换为随机密钥

# ===========================================
# 其他配置（一般不需要修改）
# ===========================================
JWT_EXPIRES_IN=24h
PORT=3000
NODE_ENV=production

# ===========================================
# 库存预警配置（可选）
# ===========================================
# 库存预警webhook（支持钉钉/企微机器人）
# STOCK_ALERT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
